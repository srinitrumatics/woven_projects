function failure() {
  document.querySelector('div.slds-text-longform.interstitial.interstitial-success').style.display = "none";
  document.querySelector('div.slds-text-longform.interstitial.interstitial-failure').style.display = "block";
}



function start(hostnames) {
  var startTime = Date.now();
  var urlParams = new URL(window.location.href).searchParams;
  var timer = 1;

  var interval = setInterval(function () {
    if (timer <= 0) {
      clearInterval(interval);
      failure();
      return;
    }

    if (result.success === hostnames.length) {
      clearInterval(interval);
      success();
      return;
    }

    if (Date.now() - startTime > totalThresholdDelay) {
      clearInterval(interval);
      failure();
      return;
    }

    for (var i = 0; i < hostnames.length; i++) {
      if (result["host" + i] === undefined) {
        result["host" + i] = false;
      }
      if (!result["host" + i]) {
        test(i);
      }
    }
  }, retry);
}

start(hosts);

</script>
</body>
</html>


